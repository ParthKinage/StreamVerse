// Prisma schema for StreamVerse (Tesor_gp).
// Money columns are Decimal(38,18); application code converts with bigint wei helpers from @tesor_gp/shared.

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

enum Role {
  USER
  CREATOR
  ADMIN
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/** Lifecycle of a live stream; transitions are enforced in apps/api/src/modules/live/lifecycle.ts. */
enum LiveStatus {
  CREATED
  STARTING
  LIVE
  ENDING
  ENDED
  FAILED
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  SETTLED
}

enum SettlementStatus {
  PENDING
  SETTLED
  FAILED
}

enum RewardStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  username      String   @unique
  walletAddress String?  @unique
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creatorProfile CreatorProfile?
  watchSessions  WatchSession[]
  settlements    PaymentSettlement[]
  rewards        TokenReward[]
  refreshTokens  RefreshToken[]
  escrowAccount  EscrowAccount?
  ledgerEntries  LedgerEntry[]
  managedWallet  ManagedWallet?
  coinOrders     CoinOrder[]
  purchases      VideoPurchase[]
  paidSegments   PaidSegment[]
  watchlist      WatchlistItem[]
  likes          VideoLike[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreatorProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  channelName   String
  bio           String?
  totalEarnings Decimal  @default(0) @db.Decimal(38, 18)
  createdAt     DateTime @default(now())

  user        User                @relation(fields: [userId], references: [id])
  videos      Video[]
  settlements PaymentSettlement[]
  liveStreams LiveStream[]
}

model Video {
  id                String           @id @default(uuid())
  title             String
  description       String
  creatorId         String
  originalFilePath  String
  hlsManifestPath   String?
  thumbnailPath     String?
  durationSeconds   Int              @default(0)
  /** Legacy one-time price (kept for history). Viewers now pay ratePerMinuteSTRM per second watched. */
  priceSTRM         Decimal          @default(20) @db.Decimal(38, 18)
  ratePerMinuteSTRM Decimal          @default(1) @db.Decimal(38, 18)
  category          String           @default("General")
  tags              String[]
  processingStatus  ProcessingStatus @default(PENDING)
  transcodeProgress Int              @default(0)
  failureReason     String?
  isPublished       Boolean          @default(false)
  archivedAt        DateTime?
  viewsCount        Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  creator       CreatorProfile      @relation(fields: [creatorId], references: [id])
  watchSessions WatchSession[]
  settlements   PaymentSettlement[]
  purchases     VideoPurchase[]
  paidSegments  PaidSegment[]
  watchlist     WatchlistItem[]
  likes         VideoLike[]
  liveStream    LiveStream?

  @@index([creatorId])
  @@index([isPublished, processingStatus, createdAt])
  @@index([category])
}

model WatchSession {
  id                      String        @id @default(uuid())
  userId                  String
  videoId                 String
  playbackToken           String        @unique
  ratePerMinuteSTRM       Decimal       @default(0) @db.Decimal(38, 18)
  verifiedDurationSeconds Int           @default(0)
  chargedSTRM             Decimal       @default(0) @db.Decimal(38, 18)
  lastSequence            Int           @default(0)
  lastPlaybackTime        Float         @default(0)
  lastHeartbeatResponse   Json?
  viewCounted             Boolean       @default(false)
  status                  SessionStatus @default(ACTIVE)
  startedAt               DateTime      @default(now())
  lastHeartbeatAt         DateTime      @default(now())
  endedAt                 DateTime?
  endReason               String?

  user        User                @relation(fields: [userId], references: [id])
  video       Video               @relation(fields: [videoId], references: [id])
  heartbeats  WatchHeartbeat[]
  settlements PaymentSettlement[]

  @@index([userId, status])
  @@index([videoId])
  @@index([status, lastHeartbeatAt])
}

model WatchHeartbeat {
  id              String   @id @default(uuid())
  sessionId       String
  sequence        Int
  playbackTime    Float
  creditedSeconds Int      @default(0)
  createdAt       DateTime @default(now())

  session WatchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
}

model PaymentSettlement {
  id                  String           @id @default(uuid())
  settlementKey       String           @unique
  sessionId           String?
  userId              String
  creatorId           String
  videoId             String
  watchedSeconds      Int
  amountSTRM          Decimal          @db.Decimal(38, 18)
  platformFeeSTRM     Decimal          @db.Decimal(38, 18)
  creatorEarningsSTRM Decimal          @db.Decimal(38, 18)
  txHash              String?
  status              SettlementStatus @default(PENDING)
  attempts            Int              @default(0)
  lastError           String?
  settledAt           DateTime?
  escrowAppliedAt     DateTime?
  createdAt           DateTime         @default(now())

  user    User           @relation(fields: [userId], references: [id])
  session  WatchSession?   @relation(fields: [sessionId], references: [id])
  creator  CreatorProfile  @relation(fields: [creatorId], references: [id])
  video    Video           @relation(fields: [videoId], references: [id])
  purchase VideoPurchase?

  @@index([sessionId])
  @@index([userId, status])
  @@index([creatorId])
  @@index([videoId])
  @@index([status, createdAt])
}

model TokenReward {
  id            String       @id @default(uuid())
  userId        String
  reason        String
  walletAddress String?
  amountSTRM    Decimal      @db.Decimal(38, 18)
  txHash        String?
  status        RewardStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, reason])
  @@unique([walletAddress, reason])
  @@index([status])
}

model EscrowAccount {
  id                String    @id @default(uuid())
  userId            String    @unique
  onChainBalance    Decimal   @default(0) @db.Decimal(38, 18)
  pendingWithdrawal Decimal   @default(0) @db.Decimal(38, 18)
  withdrawUnlockAt  DateTime?
  updatedAtBlock    BigInt    @default(0)
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Demo-bank ledger (PAYMENTS_MODE=bank): money added from or sent back to a dummy bank account, and creator cash-outs.
model LedgerEntry {
  id            String   @id @default(uuid())
  userId        String
  /// BANK_TOPUP | BANK_WITHDRAW | CREATOR_PAYOUT
  type          String
  amountSTRM    Decimal  @db.Decimal(38, 18)
  bankAccountId String?
  label         String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type])
}

model ChainEvent {
  id          String    @id @default(uuid())
  txHash      String
  logIndex    Int
  name        String
  address     String?
  blockNumber BigInt
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([txHash, logIndex])
  @@index([address, blockNumber])
  @@index([blockNumber])
}

model ChainCursor {
  id                 String   @id @default(uuid())
  chainId            Int
  contract           String
  lastProcessedBlock BigInt   @default(0)
  updatedAt          DateTime @updatedAt

  @@unique([chainId, contract])
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

model VideoLike {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

/// A viewer's paid, time-limited access to one video. The payment itself is the linked PaymentSettlement.
model VideoPurchase {
  id           String   @id @default(uuid())
  userId       String
  videoId      String
  settlementId String   @unique
  amountSTRM   Decimal  @db.Decimal(38, 18)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video             @relation(fields: [videoId], references: [id])
  settlement PaymentSettlement @relation(fields: [settlementId], references: [id])

  @@index([userId, videoId, expiresAt])
  @@index([videoId])
}

/// Built-in wallet (WALLET_MODE=managed). The address is derived from WALLET_MASTER_SEED and this row's index,
/// so no private key is ever stored in the database.
model ManagedWallet {
  index     Int      @id @default(autoincrement())
  userId    String   @unique
  address   String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Coins a viewer bought. The relayer credits them on-chain with this row's id, so a retry can never credit twice.
model CoinOrder {
  id            String       @id @default(uuid())
  userId        String
  walletAddress String
  amountSTRM    Decimal      @db.Decimal(38, 18)
  /// Who took the payment: "demo-bank" today, a real payment gateway later.
  provider      String       @default("demo-bank")
  bankAccountId String?
  label         String
  status        RewardStatus @default(PENDING)
  txHash        String?
  attempts      Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Small key/value store for facts about this installation (for example which ledger the money tables belong to).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A 4-second piece of a video a viewer has paid for. Paid once, free to rewatch forever.
model PaidSegment {
  userId       String
  videoId      String
  segmentIndex Int
  durationMs   Int
  amountSTRM   Decimal  @db.Decimal(38, 18)
  sessionId    String
  createdAt    DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id])

  @@id([userId, videoId, segmentIndex])
  @@index([sessionId])
  @@index([videoId])
}

/**
 * A live stream sent from the creator's browser in 4-second pieces. Its media, watch sessions and per-second charges
 * belong to a normal Video row (videoId), so billing is shared with videos on demand; when the stream ends the same
 * Video becomes the recording.
 */
model LiveStream {
  id          String     @id @default(uuid())
  creatorId   String
  videoId     String     @unique
  status      LiveStatus @default(CREATED)
  /** Keep the recording as a normal video when the stream ends. */
  saveAsVod   Boolean    @default(true)
  /** HLS CODECS value, e.g. "avc1.42001f,mp4a.40.2", reported by the browser that encodes the stream. */
  codecs      String?
  width       Int?
  height      Int?
  bandwidth   Int?
  /** Bumped each time the creator (re)connects with a new init segment; pieces of one run share it. */
  initSeq     Int        @default(0)
  peakViewers Int        @default(0)
  startedAt   DateTime?
  lastPieceAt DateTime?
  endedAt     DateTime?
  endReason   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  creator  CreatorProfile @relation(fields: [creatorId], references: [id])
  video    Video          @relation(fields: [videoId], references: [id])
  segments LiveSegment[]

  @@index([status, startedAt])
  @@index([creatorId, createdAt])
}

/** One uploaded piece of a live stream. `index` is the same numbering viewers are charged by (PaidSegment.segmentIndex). */
model LiveSegment {
  liveStreamId String
  index        Int
  initSeq      Int
  durationMs   Int
  createdAt    DateTime @default(now())

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)

  @@id([liveStreamId, index])
}

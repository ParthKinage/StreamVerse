# StreamVerse (Tesor_gp) environment. Copy to .env and adjust.

# Server & network
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database & cache (docker compose up gives you both)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tesor_gp?schema=public"
REDIS_URL="redis://localhost:6379"

# Security (change all of these outside local development)
JWT_SECRET="change-me-jwt-secret-at-least-16"
COOKIE_SECRET="change-me-cookie-secret-at-least-16"
PLAYBACK_SIGNING_SECRET="change-me-playback-secret-at-least-16"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Payments. "bank" = simulated bank wallet (prototype, no blockchain needed); "chain" = STRM tokens on a blockchain.
PAYMENTS_MODE=bank
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
PLATFORM_FEE_BPS=0
BANK_MIN_TOPUP=10
BANK_MAX_TOPUP=50000

# Blockchain (only used when PAYMENTS_MODE=chain). CHAIN_ID 31337 = local Hardhat node (dev + tests), 80002 = Polygon Amoy (demo)
CHAIN_ID=31337
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
# RPC_URL defaults to http://127.0.0.1:8545 on 31337 and POLYGON_AMOY_RPC_URL otherwise
RPC_URL=
# Filled in by `npm run deploy:local -w @tesor_gp/contracts` (it prints these lines)
STREAMCOIN_TOKEN_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
# Rejected in production when empty or all zeros. On chain 31337 a Hardhat account is used by default.
SETTLEMENT_RELAYER_PRIVATE_KEY=
# Contract deployment only. Never used by the API at runtime.
DEPLOYER_PRIVATE_KEY=
# Optional deploy-time parameters (defaults: 100000000 STRM, 1000 bps = 10%, 900 s)
STRM_INITIAL_SUPPLY=
FEE_BPS=
WITHDRAW_DELAY_SEC=
EXPLORER_URL="https://amoy.polygonscan.com"
# First block the indexer scans. Optional: defaults to the block in contracts/deployments/<chainId>.json
DEPLOYMENT_BLOCK=
CONFIRMATIONS=            # default: 1 on 31337, 3 otherwise
SETTLE_BATCH_SIZE=25
SETTLE_MAX_ATTEMPTS=8
WELCOME_BONUS_STRM=50

# Video processing & storage (only "local" is implemented)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
HLS_OUTPUT_DIR="./hls-output"
FFMPEG_PATH="ffmpeg"
MAX_UPLOAD_MB=1024
TRANSCODE_CONCURRENCY=1

# Watch-time billing
HEARTBEAT_INTERVAL_SEC=10
PLAYBACK_TOKEN_TTL_SEC=30
SESSION_TIMEOUT_SEC=45

# AI service
AI_SERVICE_URL="http://localhost:5000"
AI_PORT=5000
AI_TIMEOUT_MS=800
AI_FALLBACK_MODE="trending"

# Web client (Vite)
VITE_API_BASE=/api/v1
# Where the Vite dev server proxies /api and /playback (default http://localhost:4000)
VITE_PROXY_TARGET=
# Test-only: injects an in-page EIP-1193 wallet. Never set outside the e2e harness.
VITE_E2E=

# Rate limiting (per IP per minute) and password hashing cost
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
BCRYPT_ROUNDS=10
FFPROBE_PATH="ffprobe"

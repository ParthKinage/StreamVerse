# StreamVerse (Tesor_gp) environment. Copy to .env and adjust.

# Server & network
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database & cache (docker compose up gives you both)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tesor_gp?schema=public"
REDIS_URL="redis://localhost:6379"

# Security (change all of these outside local development)
JWT_SECRET="change-me-jwt-secret-at-least-16"
COOKIE_SECRET="change-me-cookie-secret-at-least-16"
PLAYBACK_SIGNING_SECRET="change-me-playback-secret-at-least-16"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Payments. "bank" = simulated bank wallet (prototype, no blockchain needed); "chain" = STRM tokens on a blockchain.
PAYMENTS_MODE=bank
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
PLATFORM_FEE_BPS=0
BANK_MIN_TOPUP=10
BANK_MAX_TOPUP=50000

# Wallets in chain mode. "managed" (default) = every account gets a built-in blockchain wallet at sign-up, buys coins
# with the demo bank and never needs gas: the platform's relayer pays it. "external" = users link MetaMask themselves.
WALLET_MODE=managed
# Secret that every built-in wallet is derived from: 0x + 64 hex characters. Generate once, keep it private, never
# change it (changing or losing it orphans every wallet). Not needed on the local chain 31337.
#   node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
WALLET_MASTER_SEED=
# Smallest creator payout (each payout costs the platform gas) and how many coins one account may buy per 24 hours.
MIN_PAYOUT_STRM=1
TOPUP_DAILY_LIMIT_STRM=10000
# The relayer waits this long so payments made close together share one transaction (and one gas fee).
BATCH_WINDOW_MS=2000
# The admin page warns when the relayer's gas drops below this many thousandths of the native coin (150 = 0.15).
LOW_GAS_MILLI=150
# Set to true for ONE start when you point the app at a different contract or chain: it clears the old balances and
# payment records, which no longer match anything. Accounts, videos and wallets are kept. (Moving from the demo bank to
# a chain clears the simulated bank money automatically, without this.)
LEDGER_RESET_ON_CHANGE=false

# Blockchain (only used when PAYMENTS_MODE=chain). CHAIN_ID 31337 = local Hardhat node (dev + tests), 80002 = Polygon Amoy (demo)
CHAIN_ID=31337
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
# RPC_URL defaults to http://127.0.0.1:8545 on 31337 and POLYGON_AMOY_RPC_URL otherwise
RPC_URL=
# RPC URL given to browsers (for adding the network to a linked wallet). The URLs above stay on the server, because
# provider URLs usually contain a private API key. Defaults to the public Amoy endpoint on chain 80002.
PUBLIC_RPC_URL=
# Filled in by `npm run deploy:local -w @tesor_gp/contracts` (it prints these lines)
STREAMCOIN_TOKEN_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
# Rejected in production when empty or all zeros. On chain 31337 a Hardhat account is used by default.
SETTLEMENT_RELAYER_PRIVATE_KEY=
# Contract deployment only. Never used by the API at runtime.
DEPLOYER_PRIVATE_KEY=
# Optional deploy-time parameters (defaults: 100000000 STRM, 3000 bps = 30% platform commission, 900 s).
# The commission can be changed later with `npx hardhat platform:set-fee --bps <n> --network <name>` (maximum 3000).
STRM_INITIAL_SUPPLY=
FEE_BPS=
WITHDRAW_DELAY_SEC=
EXPLORER_URL="https://amoy.polygonscan.com"
# First block the indexer scans. Optional: defaults to the block in contracts/deployments/<chainId>.json
DEPLOYMENT_BLOCK=
CONFIRMATIONS=            # default: 1 on 31337, 3 otherwise
SETTLE_BATCH_SIZE=25
SETTLE_MAX_ATTEMPTS=8
WELCOME_BONUS_STRM=50

# Video storage. "local" = files on this machine's disk (development). "s3" = any S3-compatible bucket (hosting):
# videos survive restarts, browsers upload straight to the bucket and play segments from it.
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
HLS_OUTPUT_DIR="./hls-output"
# Needed when STORAGE_PROVIDER=s3. Backblaze B2 example: endpoint https://s3.<region>.backblazeb2.com, region e.g.
# us-east-005, an application key limited to the bucket (keyID + applicationKey). Never commit real keys.
# Local test server (docker compose up -d s3): http://localhost:7070, us-east-1, devaccesskey/devsecretkey, path style.
# After setting them, run `npm run setup:bucket` once to allow browser uploads and playback (CORS).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
UPLOAD_URL_TTL_SEC=3600
SEGMENT_URL_SLACK_SEC=600
# How often to mark videos whose files are gone as FAILED (minutes, 0 = never).
MEDIA_RECONCILE_EVERY_MIN=60
FFMPEG_PATH="ffmpeg"
MAX_UPLOAD_MB=1024
TRANSCODE_CONCURRENCY=1
# Renditions to produce (360p, 480p, 720p, 1080p). Use a single "480p" on small hosts.
TRANSCODE_LADDER="360p,720p,1080p"
# FFmpeg threads per encode (0 = FFmpeg decides).
TRANSCODE_THREADS=0

# Watch-time billing
HEARTBEAT_INTERVAL_SEC=10
PLAYBACK_TOKEN_TTL_SEC=30
SESSION_TIMEOUT_SEC=45

# AI service
AI_SERVICE_URL="http://localhost:5000"
AI_PORT=5000
AI_TIMEOUT_MS=800
AI_FALLBACK_MODE="trending"

# Web client (Vite)
VITE_API_BASE=/api/v1
# Where the Vite dev server proxies /api and /playback (default http://localhost:4000)
VITE_PROXY_TARGET=
# Test-only: injects an in-page EIP-1193 wallet. Never set outside the e2e harness.
VITE_E2E=

# Rate limiting (per IP per minute) and password hashing cost
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
BCRYPT_ROUNDS=10
FFPROBE_PATH="ffprobe"
